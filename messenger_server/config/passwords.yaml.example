# Example Serverpod passwords file. Copy to config/passwords.yaml (gitignored)
# and replace secrets. Do not use these placeholder values in production.
#
# Generate the application-layer encryption key with:
#   openssl rand -hex 32
#
# Deployment can instead set:
#   SERVERPOD_PASSWORD_applicationEncryptionKey=<64 hex chars>
#
# Changing the key makes existing encrypted rows unreadable. Do not generate
# a new key on every server start.

shared:
  applicationEncryptionKey: 'REPLACE_WITH_OUTPUT_OF_openssl_rand_-hex_32'

development:
  database: 'replace-me'
  redis: 'replace-me'
  serviceSecret: 'replace-me'
  emailSecretHashPepper: 'replace-me'
  jwtHmacSha512PrivateKey: 'replace-me'
  jwtRefreshTokenHashPepper: 'replace-me'

  # Gmail SMTP for Email IDP registration and password-reset codes.
  # smtpPassword is a Gmail App Password. Never commit the real value.
  # Deployment can instead set SERVERPOD_PASSWORD_smtpPassword.
  smtpHost: smtp.gmail.com
  smtpPort: '587'
  smtpUsername: tictactoe.admin@gmail.com
  smtpPassword: 'REPLACE_WITH_LOCAL_GMAIL_APP_PASSWORD'
  smtpFrom: tictactoe.admin@gmail.com

test:
  database: 'replace-me'
  redis: 'replace-me'
  emailSecretHashPepper: 'replace-me'
  jwtHmacSha512PrivateKey: 'replace-me'
  jwtRefreshTokenHashPepper: 'replace-me'
